    {{-- Sheaf's header-sidebar grid always reserves a column for the sidebar. This
         layout keeps its sidebar for mobile only, so the column is collapsed at
         the width the sidebar hides at. --}}
    <body class="min-h-screen bg-white dark:bg-zinc-800 [&_[data-slot=layout]]:lg:grid-cols-1 [&_[data-slot=layout]]:lg:[grid-template-areas:'header'_'main']">
        <x-ui.layout variant="header-sidebar">
            <x-ui.layout.header class="border-b border-zinc-200 bg-zinc-50 p-0! dark:border-zinc-700 dark:bg-zinc-900">
                {{-- The kit centred the bar on a container rather than letting it
                     run the width of the screen. Sheaf's header is the whole grid
                     row, so the container is a child of it — and the header hands
                     over its own padding of 2, because the gutter belongs to the
                     container and the kit measured it from the edge. --}}
                <div class="mx-auto flex h-full w-full max-w-7xl items-center px-6 lg:px-8">
                    {{-- Sheaf's toggle draws its own glyph and takes no icon. --}}
                    <x-ui.sidebar.toggle class="lg:hidden mr-2" />

                    <x-app-logo href="{{ route('dashboard') }}" wire:navigate />

                    <x-ui.navbar class="-mb-px max-lg:hidden">
