                            icon="squares-2x2"
                            :label="__('Dashboard')"
                            :href="route('dashboard')"
                            :current="request()->routeIs('dashboard')"
                            wire:navigate
                        />
                    </x-ui.navbar>

                    <div class="flex-1"></div>

                    {{-- The kit's navbar item drew its label from slot content, and
                         these three were given none: they are icons on the bar, and
                         the name they answer to is a tooltip. Sheaf's item always
                         draws its label, so the span is taken out of the row and the
                         name moves to where the kit kept it. --}}
                    <x-ui.navbar class="me-1.5 space-x-0.5 rtl:space-x-reverse py-0!">
                        <x-ui.tooltip placement="bottom">
                            <x-slot:trigger>
                                <x-ui.navbar.item
                                    class="h-10 [&>span]:hidden"
                                    icon="magnifying-glass"
                                    href="#"
                                    :aria-label="__('Search')"
                                />
                            </x-slot:trigger>

                            <x-ui.tooltip.content>{{ __('Search') }}</x-ui.tooltip.content>
                        </x-ui.tooltip>

                        <x-ui.tooltip placement="bottom" class="max-lg:hidden">
