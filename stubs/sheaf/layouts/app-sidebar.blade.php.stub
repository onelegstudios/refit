            <x-ui.layout.main class="flex flex-col">
                <x-ui.layout.header class="lg:hidden">
                    {{-- Sheaf's toggle draws its own glyph and takes no icon. --}}
                    <x-ui.sidebar.toggle class="lg:hidden" />

